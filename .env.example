# ==============================================================================
# RakshaPath Environment Variables Template
# Copy this file to .env and fill in the values before running locally or in prod.
# DO NOT commit the actual .env file to version control.
# ==============================================================================

# Application & Environment
APP_NAME=RakshaPath
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
JWT_SECRET=change-this-to-a-secure-random-jwt-secret-min-32-chars
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL + PostGIS)
POSTGRES_USER=rakshapath
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=rakshapath_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rakshapath:replace_with_local_password@db:5432/rakshapath_db

# Redis & Message Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# External APIs & Connectors
TOMTOM_API_KEY=your_tomtom_api_key_here
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# Notifications & Alerts (Online Channels)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
FIREBASE_CREDENTIALS_PATH=infra/firebase-adminsdk.json

# LLM / News Extractor
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# System Thresholds & Business Rules
ROUTE_HAZARD_BUFFER_METERS=200
PUSH_ALERT_RADIUS_METERS=5000
SOS_CANCEL_WINDOW_SECONDS=5
MISSED_UPDATE_THRESHOLD_SECONDS=180
DEMO_MODE=true
