# PostgreSQL connection string with PostGIS (Neon, Supabase, local, or Docker)
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# Optional Redis connection URL (leave empty for in-memory fallback)
REDIS_URL=

# Secret key for JWT token signing (minimum 32 characters)
JWT_SECRET=rakshapath-secret-jwt-key-minimum-32-chars-long!

# Optional TomTom Traffic API key (connector reports 'not configured' if omitted)
TOMTOM_API_KEY=

# Optional OpenRouteService API key for alternative routing (reports 'not configured' if omitted)
OPENROUTESERVICE_API_KEY=

# Open-Meteo Weather API endpoint (free, no API key required)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# Optional Twilio Account SID for live SMS dispatch
TWILIO_ACCOUNT_SID=

# Optional Twilio Auth Token for live SMS dispatch
TWILIO_AUTH_TOKEN=

# Optional Twilio sender phone number
TWILIO_PHONE_NUMBER=

# Allowed CORS origins for web and mobile development (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Application environment mode
ENVIRONMENT=development

# Application log verbosity
LOG_LEVEL=INFO

